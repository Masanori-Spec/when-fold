[
  {
    "key": "ctrl+alt+k",
    "command": "demo.generic",
    "when": "whenfold.focus",
    "args": {
      "kind": "generic"
    }
  },
  {
    "key": "ctrl+alt+k",
    "command": "demo.python",
    "when": "whenfold.focus && whenfold.lang == python",
    "args": {
      "kind": "python",
      "nested": {
        "preserve": [
          "a",
          false,
          null
        ]
      }
    }
  },
  {
    "key": "ctrl+alt+k",
    "command": "demo.selection",
    "when": "whenfold.focus && whenfold.selection",
    "args": {
      "kind": "selection"
    }
  }
]
